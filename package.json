{
  "name": "@l2utils/l2data",
  "version": "0.1.0",
  "description": "Lineage 2 binary .dat file deserializer and schema parser",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "l2data": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "parse": "ts-node src/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/l2utils/l2data.git"
  },
  "keywords": [
    "Lineage 2",
    "dat",
    "deserializer",
    "parser",
    "l2data"
  ],
  "author": "",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/l2utils/l2data/issues"
  },
  "homepage": "https://github.com/l2utils/l2data#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.5",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "commander": "^14.0.2"
  }
}
